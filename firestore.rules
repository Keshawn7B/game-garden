rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['premiumUnlocked']) || request.resource.data.premiumUnlocked is bool)
        && (!request.resource.data.keys().hasAny(['premiumUnlockedAt']) || request.resource.data.premiumUnlockedAt is timestamp);
    }

    match /users/{userId}/friends/{friendId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && friendId != userId
        && request.resource.data.uid == friendId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 18
        && validAccountAvatar(friendId, request.resource.data.avatarId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 18
        && request.resource.data.friendCode is string
        && request.resource.data.friendCode.size() == 8
        && request.resource.data.highScores is map
        && (!request.resource.data.keys().hasAny(['online']) || request.resource.data.online is bool)
        && (!request.resource.data.keys().hasAny(['lastActiveAt']) || request.resource.data.lastActiveAt is timestamp)
        && validAccountAvatar(userId, request.resource.data.avatarId);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /directChats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if validNewDirectChat(chatId, request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && validDirectChatShape(chatId, request.resource.data)
        && request.resource.data.userA == resource.data.userA
        && request.resource.data.userB == resource.data.userB
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userAName', 'userAAvatar', 'userBName', 'userBAvatar', 'lastMessage', 'lastSenderUid', 'lastMessageAt', 'unreadBy', 'updatedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage', 'lastSenderUid', 'lastMessageAt'])
          || (request.resource.data.lastSenderUid == request.auth.uid
            && request.resource.data.lastMessageAt == request.time));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.auth.uid in getAfter(/databases/$(database)/documents/directChats/$(chatId)).data.participants
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 18
          && validAvatar(request.resource.data.senderAvatar)
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && request.resource.data.sentAt == request.time
          && request.resource.data.keys().hasOnly(['senderUid', 'senderName', 'senderAvatar', 'text', 'sentAt']);
        allow update, delete: if false;
      }
    }

    match /invites/{inviteId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if validNewInvite(inviteId, request.resource.data);
      allow update: if validInviteShape(inviteId, request.resource.data)
        && (
          (request.auth.uid == resource.data.toUid
            && resource.data.status == 'pending'
            && resource.data.expiresAt > request.time
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.respondedAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'updatedAt']))
          ||
          (request.auth.uid == resource.data.fromUid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.respondedAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'updatedAt']))
          ||
          (request.auth.uid == resource.data.fromUid
            && (resource.data.status in ['declined', 'cancelled']
              || (resource.data.status == 'pending' && resource.data.expiresAt <= request.time))
            && validNewInvite(inviteId, request.resource.data))
        );
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid)
        && (resource.data.status != 'pending' || resource.data.expiresAt <= request.time);
    }

    match /rooms/{roomCode} {
      allow read: if request.auth != null
        && validRoomCode(roomCode);
      allow create: if validNewRoom(roomCode, request.resource.data);
      allow update: if request.auth != null
        && (
          (resource.data.status == 'open'
            && resource.data.expiresAt > request.time
            && !resource.data.keys().hasAny(['guestUid', 'guestName', 'guestAvatar'])
            && request.auth.uid != resource.data.hostUid
            && request.resource.data.guestUid == request.auth.uid
            && request.resource.data.guestName is string
            && request.resource.data.guestName.size() >= 2
            && request.resource.data.guestName.size() <= 18
            && validAvatar(request.resource.data.guestAvatar)
            && request.resource.data.status == 'ready'
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestUid', 'guestName', 'guestAvatar', 'status', 'updatedAt']))
          ||
          (resource.data.status == 'ready'
            && request.auth.uid == resource.data.hostUid
            && resource.data.keys().hasAll(['guestUid'])
            && request.resource.data.status == 'playing'
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.hostUid || request.auth.uid == resource.data.guestUid);
    }

    match /rooms/{roomCode}/numberHunt/{documentId} {
      allow read: if roomParticipant(roomCode)
        && (documentId == 'state' || resource.data.keeperUid == request.auth.uid);
      allow create: if roomParticipant(roomCode)
        && (
          (documentId == 'state'
            && request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid
            && validNumberState(roomCode, request.resource.data))
          ||
          (documentId.matches('^secret-[12]$')
            && request.resource.data.keeperUid == request.auth.uid
            && request.resource.data.value is int
            && request.resource.data.value >= 1
            && request.resource.data.value <= 100
            && request.resource.data.round in [1, 2])
        );
      allow update: if roomParticipant(roomCode)
        && (
          (documentId == 'state' && validNumberState(roomCode, request.resource.data))
          ||
          (documentId.matches('^secret-[12]$')
            && resource.data.keeperUid == request.auth.uid
            && request.resource.data.keeperUid == request.auth.uid
            && request.resource.data.value is int
            && request.resource.data.value >= 1
            && request.resource.data.value <= 100)
        );
      allow delete: if roomParticipant(roomCode);
    }

    match /rooms/{roomCode}/game/{documentId} {
      allow read: if documentId == 'state' && roomParticipant(roomCode);
      allow create: if documentId == 'state'
        && roomParticipant(roomCode)
        && request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid
        && validOnlineGameState(roomCode, request.resource.data);
      allow update: if documentId == 'state'
        && roomParticipant(roomCode)
        && validOnlineGameState(roomCode, request.resource.data)
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.players == resource.data.players
        && request.resource.data.names == resource.data.names
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if documentId == 'state' && roomParticipant(roomCode);
    }

    match /leaderboards/{gameId}/entries/{userId} {
      allow read: if true;
      allow create: if validScore(gameId, userId);
      allow update: if validScore(gameId, userId)
        && request.resource.data.score <= resource.data.score;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    function validScore(gameId, userId) {
      return request.auth != null
        && request.auth.uid == userId
        && gameId in ['codebreaker', 'order', 'number', 'memory', 'tictactoe', 'connect4', 'rps', 'dice']
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 18
        && validAccountAvatar(userId, request.resource.data.avatarId)
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 10000;
    }

    function otherChatUser(chat) {
      return chat.userA == request.auth.uid ? chat.userB : chat.userA;
    }

    function validNewDirectChat(chatId, chat) {
      return request.auth != null
        && request.auth.uid in chat.participants
        && validDirectChatShape(chatId, chat)
        && chat.lastSenderUid == request.auth.uid
        && chat.lastMessageAt == request.time
        && chat.updatedAt == request.time
        && (exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(otherChatUser(chat)))
          || exists(/databases/$(database)/documents/users/$(otherChatUser(chat))/friends/$(request.auth.uid)));
    }

    function validDirectChatShape(chatId, chat) {
      return chat.keys().hasOnly(['userA', 'userB', 'participants', 'userAName', 'userAAvatar', 'userBName', 'userBAvatar', 'lastMessage', 'lastSenderUid', 'lastMessageAt', 'unreadBy', 'updatedAt'])
        && chat.userA is string
        && chat.userB is string
        && chat.userA != chat.userB
        && chatId == chat.userA + '--' + chat.userB
        && chat.participants == [chat.userA, chat.userB]
        && chat.userAName is string
        && chat.userAName.size() >= 1
        && chat.userAName.size() <= 18
        && chat.userBName is string
        && chat.userBName.size() >= 1
        && chat.userBName.size() <= 18
        && validAvatar(chat.userAAvatar)
        && validAvatar(chat.userBAvatar)
        && chat.lastMessage is string
        && chat.lastMessage.size() >= 1
        && chat.lastMessage.size() <= 500
        && chat.lastSenderUid in chat.participants
        && chat.lastMessageAt is timestamp
        && chat.unreadBy is map
        && chat.updatedAt is timestamp;
    }

    function validNewInvite(inviteId, invite) {
      return request.auth != null
        && request.auth.uid == invite.fromUid
        && invite.status == 'pending'
        && invite.createdAt == request.time
        && invite.updatedAt == request.time
        && invite.expiresAt is timestamp
        && invite.expiresAt > request.time
        && invite.keys().hasOnly(['fromUid', 'fromName', 'fromAvatar', 'toUid', 'toName', 'toAvatar', 'gameId', 'gameName', 'status', 'createdAt', 'updatedAt', 'expiresAt', 'roomCode'])
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(invite.toUid))
        && (!invite.keys().hasAny(['roomCode'])
          || (validRoomCode(invite.roomCode)
            && exists(/databases/$(database)/documents/rooms/$(invite.roomCode))
            && get(/databases/$(database)/documents/rooms/$(invite.roomCode)).data.hostUid == request.auth.uid
            && get(/databases/$(database)/documents/rooms/$(invite.roomCode)).data.gameId == invite.gameId))
        && validInviteShape(inviteId, invite);
    }

    function validInviteShape(inviteId, invite) {
      return ((!invite.keys().hasAny(['roomCode']) && inviteId == invite.fromUid + '--' + invite.toUid + '--' + invite.gameId)
          || (invite.keys().hasAny(['roomCode']) && validRoomCode(invite.roomCode) && inviteId == invite.fromUid + '--' + invite.toUid + '--' + invite.gameId + '--' + invite.roomCode))
        && invite.fromUid is string
        && invite.toUid is string
        && invite.fromUid != invite.toUid
        && invite.fromName is string
        && invite.fromName.size() >= 1
        && invite.fromName.size() <= 18
        && invite.toName is string
        && invite.toName.size() >= 1
        && invite.toName.size() <= 18
        && validAvatar(invite.fromAvatar)
        && validAvatar(invite.toAvatar)
        && validInviteGame(invite.gameId, invite.gameName)
        && invite.status in ['pending', 'accepted', 'declined', 'cancelled']
        && invite.createdAt is timestamp
        && invite.updatedAt is timestamp
        && invite.expiresAt is timestamp;
    }

    function validNewRoom(roomCode, room) {
      return request.auth != null
        && validRoomCode(roomCode)
        && room.code == roomCode
        && request.auth.uid == room.hostUid
        && room.hostName is string
        && room.hostName.size() >= 2
        && room.hostName.size() <= 18
        && validAvatar(room.hostAvatar)
        && validInviteGame(room.gameId, room.gameName)
        && room.status == 'open'
        && room.createdAt == request.time
        && room.updatedAt == request.time
        && room.expiresAt is timestamp
        && room.expiresAt > request.time
        && room.keys().hasOnly(['code', 'gameId', 'gameName', 'hostUid', 'hostName', 'hostAvatar', 'status', 'createdAt', 'updatedAt', 'expiresAt']);
    }

    function validRoomCode(roomCode) {
      return roomCode is string && roomCode.matches('^[A-Z2-9]{6}$');
    }

    function roomParticipant(roomCode) {
      return request.auth != null
        && exists(/databases/$(database)/documents/rooms/$(roomCode))
        && (get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid
          || get(/databases/$(database)/documents/rooms/$(roomCode)).data.guestUid == request.auth.uid);
    }

    function validNumberState(roomCode, state) {
      return state.gameId == 'number'
        && state.roomCode == roomCode
        && state.round in [1, 2]
        && state.phase in ['setting', 'guessing', 'pending', 'round-result', 'match-result']
        && state.keeperUid is string
        && state.guesserUid is string
        && state.keeperUid != state.guesserUid
        && state.keeperName is string
        && state.guesserName is string
        && state.guesses is list
        && state.guesses.size() <= 7
        && state.scores is list
        && state.scores.size() == 2
        && state.revealedSecrets is list
        && state.revealedSecrets.size() == 2
        && state.lastClue in ['none', 'higher', 'lower', 'correct'];
    }

    function validOnlineGameState(roomCode, state) {
      return state.gameId in ['codebreaker', 'order', 'memory', 'tictactoe', 'connect4', 'rps', 'dice']
        && state.roomCode == roomCode
        && state.gameId == get(/databases/$(database)/documents/rooms/$(roomCode)).data.gameId
        && state.players is list
        && state.players.size() == 2
        && state.players[0] == get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid
        && state.players[1] == get(/databases/$(database)/documents/rooms/$(roomCode)).data.guestUid
        && state.names is list
        && state.names.size() == 2
        && state.turnUid in state.players
        && state.phase in ['playing', 'revealing', 'complete']
        && state.round is int
        && state.round >= 1
        && state.moves is int
        && state.moves >= 0
        && state.scores is list
        && state.scores.size() == 2
        && state.board is list
        && state.secret is list
        && state.guesses is list
        && state.target is list
        && state.objects is list
        && state.checks is list
        && state.deck is list
        && state.open is list
        && state.matched is list
        && state.choices is list
        && state.positions is list
        && state.positions.size() == 2
        && state.faces is list
        && state.faces.size() == 2
        && state.winnerUid in ['', 'draw', state.players[0], state.players[1]]
        && state.createdAt is timestamp
        && state.updatedAt is timestamp;
    }

    function validInviteGame(gameId, gameName) {
      return (gameId == 'codebreaker' && gameName == 'Codebreaker')
        || (gameId == 'order' && gameName == 'Order Match')
        || (gameId == 'number' && gameName == 'Number Hunt')
        || (gameId == 'memory' && gameName == 'Memory Flip')
        || (gameId == 'tictactoe' && gameName == 'Tic Tac Toe')
        || (gameId == 'connect4' && gameName == 'Connect Four')
        || (gameId == 'rps' && gameName == 'Rock Paper Scissors')
        || (gameId == 'dice' && gameName == 'Dice Race');
    }

    function validAvatar(avatarId) {
      return avatarId in ['play', 'sakura', 'fox', 'koi', 'moon', 'crane', 'dragon', 'cat', 'ninja', 'sun', 'pink-blossom', 'pink-heart', 'pink-bunny', 'pink-fan', 'pink-peach', 'premium-shogun', 'premium-kitsune', 'premium-empress', 'premium-dragon', 'premium-koi', 'premium-ronin', 'premium-cat', 'premium-blossom', 'premium-dual-swords'];
    }

    function isPremiumAvatar(avatarId) {
      return avatarId in ['premium-shogun', 'premium-kitsune', 'premium-empress', 'premium-dragon', 'premium-koi', 'premium-ronin', 'premium-cat', 'premium-blossom', 'premium-dual-swords'];
    }

    function validAccountAvatar(userId, avatarId) {
      return validAvatar(avatarId)
        && (!isPremiumAvatar(avatarId)
          || (exists(/databases/$(database)/documents/users/$(userId))
            && get(/databases/$(database)/documents/users/$(userId)).data.premiumUnlocked == true));
    }
  }
}
